{% extends "forms/field.html.twig" %}

{% set passwordStored = value ? 1 : 0 %}
{% set isEncrypted = value|starts_with('gitsync-') %}
{% set value = '' %}

{% block input_attributes %}
    type="password"
    class="input"
    placeholder="{{ passwordStored ? (isEncrypted ? 'PLUGIN_GIT_SYNC.PASSWORD_SECURELY_STORED'|t : 'PLUGIN_GIT_SYNC.PASSWORD_STORED_NOT_ENCRYPTED'|t) : field.placeholder }}"
    {{ parent() }}
{% endblock %}
